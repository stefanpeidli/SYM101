rule bwa_index_genome:
    input:
        '{genome}.fa'
    output:
        genome_index=expand('{{genome}}.fa.{idx}', idx=['amb', 'ann', 'bwt', 'pac', 'sa'])
    shell:
        """
        bwa index {input}
        """

rule align_guides_to_genome_bwa:
    input:
        guide_fasta='../resources/pooled_screen_1_guides.fa',
        genome_fasta='/home/peidli/utils/genomes/homo_sapiens/Homo_sapiens.GRCh38.dna.toplevel.fa',
        genome_index=expand('/home/peidli/utils/genomes/homo_sapiens/Homo_sapiens.GRCh38.dna.toplevel.fa.{idx}', idx=['amb', 'ann', 'bwt', 'pac', 'sa'])
    output:
        TEMPDIR / 'pooled_screen_1/bwa/pooled_screen_1_guides_to_genome.sam'
    resources:
        time='10:00:00',
        mem_mb=64000,
        disk_mb=64000
    conda:
        ROOT / "environments/bwa_env.yaml"
    threads: 8
    shell:
        """
        bwa mem -t {threads} {input.genome_fasta} {input.guide_fasta} > {output}
        """

onsuccess: 
    print("Snakemake is done!")
