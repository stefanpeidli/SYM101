### UPSTREAM ###
rule download_fastq_bs:
    output:
        expand(TEMPDIR / 'pooled_screen_1/fastq/{sample}_L00{i}_R1_001.fastq', sample=sample_names, i=[1,2])
    resources:
        time='12:00:00',
        mem_mb=64000,
        disk_mb=64000,
    shell:
        """
        bs download appsession -v --id=715537995 --extension=fastq.gz -o {TEMPDIR}/pooled_screen_1/fastq/
        cd {TEMPDIR}/pooled_screen_1/fastq/
        # fastq files seem redundantly available in the subfolders
        rm -r *_L00*_ds.*
        # move all fastq files to main folder
        mv *_ds.*/*.fastq.gz .
        # remove empty subfolders
        rm -r *_ds.*
        # unzip
        gunzip *.gz
        """

rule fastqc:
    input:
        TEMPDIR / 'pooled_screen_1/fastq/{sample}_L00{i}_R1_001.fastq'
    output:
        html=TEMPDIR / "pooled_screen_1/fastqc/{sample}_L00{i}.html",
        zip=TEMPDIR / "pooled_screen_1/fastqc/{sample}_L00{i}_fastqc.zip" # the suffix _fastqc.zip is necessary for multiqc to find the file. If not using multiqc, you are free to choose an arbitrary filename
    params:
        extra = "--quiet"
    threads: 4
    resources:
        mem_mb = 1024
    wrapper:
        "v3.3.5/bio/fastqc"

rule multiqc:
    input:
        fastqc=expand(TEMPDIR / "pooled_screen_1/fastqc/{sample}_L00{i}.html", sample=sample_names, i=[1,2]),
        samtools=expand(TEMPDIR / "pooled_screen_1/hisat2/{sample}_L00{i}_R1_001_custom_trimmed_stats.txt", sample=sample_names, i=[1,2]),
    output:
        "../results/multiqc/multiqc.html",
        directory("../results/multiqc/multiqc_data"),
    params:
        extra="--data-dir",  # Optional: extra parameters for multiqc.
    log:
        "logs/multiqc.log",
    wrapper:
        "v3.3.5/bio/multiqc"

rule cutadapt_single_end:
    input:
        TEMPDIR / 'pooled_screen_1/fastq/{sample}_L00{i}_R1_001.fastq'
    output:
        fastq=TEMPDIR / 'pooled_screen_1/trimmed/{sample}_L00{i}_R1_001.fastq',
        qc=TEMPDIR / 'pooled_screen_1/trimmed/qc/{sample}_L00{i}_R1_001.qc.txt',
    params:
        primer_seq=config['primer_seq']
    threads: 8
    conda: "cutadapt_env" #  "../environments/cutadapt_env.yaml"
    shell:
        """
        cutadapt --cores {threads} \
            -g {params.primer_seq}  \
            -o {output.fastq} {input} > {output.qc} 
        """

rule custom_trimming:
    input:
        TEMPDIR / 'pooled_screen_1/fastq/{sample}_L00{i}_R1_001.fastq'
    output:
        fastq=TEMPDIR / 'pooled_screen_1/trimmed/{sample}_L00{i}_R1_001_custom_trimmed.fastq',
        qc=TEMPDIR / 'pooled_screen_1/trimmed/qc/{sample}_L00{i}_R1_001_custom_trimmed_qc.csv'
    params:
        primer_seq=config['primer_seq'],
        pmin=config['primer_range']['min'],
        pmax=config['primer_range']['max'],
        guide_length=config['guide_length']
    resources:
        mem_mb=16000,
        disk_mb=16000,
        time='12:00:00',
    threads: 8
    shell:
        """
        python scripts/variable_trimming.py -i {input} -o {output.fastq} \
            -q {output.qc} \
            -p {params.primer_seq} \
            -g {params.guide_length}  \
            -r {params.pmin},{params.pmax} \
            -t {threads}
        """

rule custom_trimming_summary:
    input:
        expand(TEMPDIR / 'pooled_screen_1/trimmed/qc/{sample}_L00{i}_R1_001_custom_trimmed_qc.csv', sample=sample_names, i=[1,2])
    output:
        table="../results/tables/trimmed_summary.csv",
        fig1="../results/figures/trimmed_summary_scatter.pdf",
        fig2="../results/figures/trimmed_summary_violing.pdf"
    run:
        import seaborn as sns
        import matplotlib.ticker as mtick
        import matplotlib.pyplot as pl

        path = Path(config['TEMPDIR']) /'pooled_screen_1/trimmed/qc'
        qcs = {x.name.split('_R1_001')[0]: pd.read_csv(x, sep='\t') for x in path.glob('*_custom_trimmed_qc.csv')}
        df = pd.concat(qcs).droplevel(1)
        df['fraction_filtered'] = df.Filtered_reads / df.Total_reads
        df['cell_line'] = [x.split('-')[1] for x in df.index]
        df['lane'] = [x.split('_')[-1] for x in df.index]
        df['replicate'] = [x.split('-')[2] if 'pool' not in x else '0'+x[-5] for x in df.index ]
        df['time_point'] = [x.split('-')[3][:3] if 'pool' not in x else 'Pool' for x in df.index ]
        df.to_csv(output.table)

        with sns.axes_style('whitegrid'):
            fig, ax = pl.subplots()
        sns.scatterplot(data=df, y='Mean_primer_distance', hue='cell_line', x='Mean_primer_certainty', ax=ax)
        pl.xlabel('Mean weighted hamming distance to primer sequence')
        pl.ylabel('Distance to second best hit')
        pl.title('Primer Detection Metrics across FASTQ files\n(still including filtered reads)')
        pl.savefig(output.fig1, dpi=300)
        pl.close()

        with sns.axes_style('whitegrid'):
            fig, ax = pl.subplots()
        sns.violinplot(data=df, x='cell_line', hue='lane', y='fraction_filtered', ax=ax, order=['01', '02', '03', 'pool'])
        ax.yaxis.set_major_formatter(mtick.PercentFormatter(1,1))
        pl.ylabel('Percent Reads Filtered')
        pl.xlabel('Library Group')
        pl.title('Fraction of Reads Removed during Trim')
        pl.savefig(output.fig2, dpi=300)
        pl.close()

rule guide_to_fasta:
    input:
        '../resources/all_gRNA_data.csv'
    output:
        '../resources/pooled_screen_1_guides.fa'
    run:
        from tqdm.auto import tqdm
        guide_df = pd.read_csv(input[0], index_col='unique_guide_name')
        print('Converting to FASTA!')
        with open(output[0], 'w') as OUTPUT:
            for index, row in tqdm(guide_df.iterrows()):
                OUTPUT.write(f'>{index}\n')
                OUTPUT.write(f'{row.GuideSeq}\n')
        print('Done!')

