        disk_mb=32000
    shell:
        """
        mkdir -p {TEMPDIR}/pooled_screen_1/igv/
        cd {TEMPDIR}/pooled_screen_1/igv/
        wget -O gencode.v45.annotation.gtf.gz https://ftp.ebi.ac.uk/pub/databases/gencode/Gencode_human/release_45/gencode.v45.annotation.gtf.gz
        wget https://ftp.ensembl.org/pub/release-112/gtf/homo_sapiens/Homo_sapiens.GRCh38.112.gtf.gz
        gunzip gencode.v45.annotation.gtf.gz

        # Convert to bed
        gtf2bed < Homo_sapiens.GRCh38.112.gtf > Homo_sapiens.GRCh38.112.bed
        # Sort
        sort -k1,1 -k2,2n gencode.v45.annotation.bed > gencode.v45.annotation.sorted.bed
        # Compression
        bgzip gencode.v45.annotation.sorted.bed
        # Indexing
        tabix -p bed gencode.v45.annotation.sorted.bed.gz
        """
    

