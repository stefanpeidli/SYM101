"""
Author: Stefan Peidli
Title: Snakemake workflow for SYMPHONY experiment pooled_screen_1.
Date: 29.05.2024
Run: snakemake
Create DAG: snakemake --forceall --dag | dot -Tpdf > snake_dag.pdf
Create Rulegraph: snakemake --forceall --rulegraph | dot -Tpdf > snake_rulegraph.pdf
Description:
    This snakemake workflow starts does the following:
    - Upstream processing
        - Download FASTQ files from BaseSpace
        - Run FastQC / MultiQC on the FASTQ files
        - Trim the FASTQ files with a custom script
        - Align the trimmed FASTQ files to the guides with HISAT2
        - Count the number of reads per guide using samtools
        - Merges the counts into a single table "pooled_screen_1_counts.csv"
    - Downstream processing
        - Runs MAGeCK
        - Runs BAGEL2
        - TODO: get scripts for Gscreend
        - Time series clustering
    - Align Guides and Check Copy Number effect
        - Run cas-offinder to find off-targets
        - Align the guides to the genome with HISAT2
        - Run CRISPRcleanR to detect CNEs
    All user configuration is done in the configuration/config.yaml file.
"""

import pandas as pd
from pathlib import Path
from snakemake.utils import min_version

min_version("6.4.1")  # set minimum snakemake version
report: "report/workflow.rst"
configfile: "../configuration/config.yaml"

### PATHS and Names ###
TEMPDIR = Path(config['TEMPDIR'])
DATADIR = Path(config['DATADIR'])
ROOT = Path("../")

sample_names = list(pd.read_csv('../resources/pooled_screen_1_fastqs.txt', sep='\t', index_col=0).index)
sample_names = [x for x in sample_names if 'Undetermined_S0' not in x]
assert len(sample_names) == 6*(3*3) + 3, f"Expected 57 (6TP x 3lines x 3reps + 3 Pools) samples, got " + str(len(sample_names))
guide_df = pd.read_csv('../resources/all_gRNA_data.csv', index_col='unique_guide_name')
cell_line_dict = config['cell_lines']
cell_lines = list(cell_line_dict.values())

### Define Outputs of this Workflow ###
