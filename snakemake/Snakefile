# https://github.com/niekwit/crispr-screens/blob/main/workflow/Snakefile

import pandas as pd
from pathlib import Path
from snakemake.utils import min_version

min_version("6.4.1")  # set minimum snakemake version
report: "report/workflow.rst"
configfile: "../configuration/config.yaml"

### PATHS ###
TEMPDIR = Path(config['TEMPDIR'])
DATADIR = Path(config['DATADIR'])

onsuccess: 
    print("Snakemake is done!")

### SUBWORKFLOWS / MODULES ###
module pooled_screen:
    snakefile: "subworkflows/pooled_screen/Snakefile"
    config: config
use rule * from pooled_screen as pooled_screen_* 

### TARGET FILES ###
rule all:
    input:
        rules.pooled_screen_all.input