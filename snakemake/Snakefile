        filtered_heatmap=expand('../results/mageck/mageck_guide_filtering_count_matrix_l2fc_heatmap.{ext}', ext=['pdf', 'png']),
        filtered_counts=TEMPDIR / 'pooled_screen_1/pooled_screen_1_counts_filtered.csv'
    log:
        notebook="../results/reports/mageck_filter_guides_report.ipynb"
    notebook: 
        'scripts/mageck_filter_guides.py.ipynb'

rule bagel2_prepare:
    input:
        counts=TEMPDIR / 'pooled_screen_1/pooled_screen_1_{counts}.csv'
    output:
        counts=temp(TEMPDIR / 'pooled_screen_1/bagel2/pooled_screen_1_{counts}_bagel2_input_{feature}_{time}_{line}.txt')
    wildcard_constraints:
        feature="gene|transcript",
        time="alltimes|TP5TP6",
        line="alllines|H1975|H1299|A549"
    run:
        df = pd.read_csv(input.counts, index_col=0)
        df.index.name = 'sgRNA'

        # Select feature grouping
        if wildcards.feature == 'gene':
            # Set gene as target feature
            sdf = df.drop(['Transcript_ID', 'ensembl_gene_id', 'transcript_biotype',
                'GuideName', 'GuideSeq', 'MatchPos', 'Guide_Score', 'Region',
                'transcript_length', 'gRNA_occurence', 'transcript_per_gene'], axis=1)
        elif wildcards.feature == 'transcript':
            # Set non-unique transcripts as target feature
            # Some transcript have only single guide --> remove them
            sdf = df.drop(['ensembl_gene_id', 'Gene', 'transcript_biotype',
                'GuideName', 'GuideSeq', 'MatchPos', 'Guide_Score', 'Region',
                'transcript_length', 'gRNA_occurence', 'transcript_per_gene'], axis=1)
            cts = sdf.value_counts('Transcript_ID')
            nonunique_IDs = cts[cts > 2].index
            sdf = sdf[sdf.Transcript_ID.isin(nonunique_IDs)]
        
        # select time points
        if wildcards.time == 'alltimes':
            # Use all timepoints
            sdf = sdf
        elif wildcards.time == 'TP5TP6':
            # Use only TP5 and TP6
            mask = [x for x in sdf.columns if ('TP5' in x or 'TP6' in x) or ('pool' in x or x=='Gene')]
            sdf = sdf.loc[:, mask]
        
        # select cell lines
        if wildcards.line == 'alllines':
            # Use all cell lines
            sdf = sdf
        else:
            # Use only one cell line (with pools still included)
            line = wildcards.line
            mask = [(cell_line_dict[int(x.split('-')[1])]==line) if 'sym' in x else True if ('pool' in x or x=='Gene') else False for x in sdf.columns]  # pool and cell line
            sdf = sdf.loc[:, mask]

        # Save as txt
        sdf.to_csv(output.counts, sep='\t')

rule bagel2_fc:
    input:
        bagel_py="/home/peidli/utils/bagel/BAGEL.py", # clone with github
        bagel_counts=TEMPDIR / 'pooled_screen_1/bagel2/pooled_screen_1_{counts}_bagel2_input_{index}.txt'
    output:
        fc=TEMPDIR / 'pooled_screen_1/bagel2/pooled_screen_1_{counts}_bagel_{index}.foldchange',
        norm=TEMPDIR / 'pooled_screen_1/bagel2/pooled_screen_1_{counts}_bagel_{index}.normed_readcount'
    shell:
        """
        # Calculate Fold Changes
        {input.bagel_py} fc -i {input.bagel_counts} \
            -o {TEMPDIR}/pooled_screen_1/bagel2/pooled_screen_1_{wildcards.counts}_bagel_{wildcards.index} \
            -c 1,2,3
        """

rule bagel2_bf:
    input:
        bagel_py="/home/peidli/utils/bagel/BAGEL.py",
        fc=TEMPDIR / 'pooled_screen_1/bagel2/pooled_screen_1_{counts}_bagel_{index}.foldchange',
        bagel_folder="/home/peidli/utils/bagel/",
    output:
        bf='../results/bagel2/pooled_screen_1_{counts}_bagel_bf_{index}.tsv'
    shell:
        """
        # Number of columns in input tsv
        D=$(head -n 1 {input.fc} | tr '\\t' '\\n' | wc -l)  # count the number of columns
        D=$((D - 2))  # remove the first two columns (guide and gene names)
        S=$(seq -s, 1 $D)  # create a string of numbers from 1 to D (Bagel needs this)
        echo $S

        # Calculate Bayes Factors
        {input.bagel_py} bf -i {input.fc} \
            -o {output.bf} \
            -e {input.bagel_folder}/CEGv2.txt \
            -n {input.bagel_folder}/NEGv1.txt \
            -c $S
        """

rule bagel2_pr:
    input:
        bagel_py="/home/peidli/utils/bagel/BAGEL.py",
        bf='../results/bagel2/pooled_screen_1_{counts}_bagel_bf_{index}.tsv',
        bagel_folder="/home/peidli/utils/bagel/",
    output:
        pr='../results/bagel2/pooled_screen_1_{counts}_bagel_pr_{index}.tsv'
    shell:
        """
        # Calculate Precision-Recall
        {input.bagel_py} pr -i {input.bf} \
            -o {output.pr} \
            -e {input.bagel_folder}/CEGv2.txt \
            -n {input.bagel_folder}/NEGv1.txt
        """

rule bagel2_merge:
    input:
        pr=expand('../results/bagel2/pooled_screen_1_{{counts}}_bagel_pr_gene_{time}_{line}.tsv', time=['alltimes', 'TP5TP6'], line=['alllines', 'H1975', 'H1299', 'A549'])
    output:
        '../results/bagel2/pooled_screen_1_{counts}_bagel_pr_gene.tsv'
    run:
        # merge BAGEL2 results
        file = f'../results/bagel2/pooled_screen_1_counts_bagel_pr_gene.tsv'

        # aggregate results
        datas = {}
        for line in ['alllines', 'A549', 'H1299', 'H1975']:
            for time in ['alltimes', 'TP5TP6']:
                tdf = pd.read_table(f'../results/bagel2/pooled_screen_1_{wildcards.counts}_bagel_pr_gene_{time}_{line}.tsv', index_col='Gene')
                datas[(line, time)] = tdf
        df = pd.concat(datas, axis=1)

        # write to file
        df.to_csv(output[0], sep='\t')

